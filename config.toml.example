# Material 配置文件
# 复制为 config.toml 后填入自己的值。请勿提交真实 API Key 到 git。
# 小红书的签名头 / Cookie 写死在 config/config.go 的 DefaultXHSConfig() 中，不在此文件配置。

[llm]
# DeepSeek 官方 API（OpenAI 兼容协议）
base_url = "https://api.deepseek.com"
# 在 https://platform.deepseek.com/ 申请
api_key = ""
# 可选：deepseek-chat（通用对话）/ deepseek-reasoner（推理模型）
model = "deepseek-chat"
