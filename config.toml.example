# Material 配置文件
# 复制为 config.toml 后填入自己的值。请勿提交真实 API Key / Cookie 到 git。

[xhs]
# 浏览器登录后的 Cookie（F12 复制）
cookie = ""
# 以下签名头由小红书前端 JS 生成且会过期，需要定期更新或自行实现签名逻辑
x_s = ""
x_s_common = ""
x_t = ""
x_b3_traceid = ""
x_rap_param = ""
x_xray_traceid = ""
xy_direction = ""

[llm]
# DeepSeek 官方 API（OpenAI 兼容协议）
base_url = "https://api.deepseek.com"
# 在 https://platform.deepseek.com/ 申请
api_key = ""
# 可选：deepseek-chat（通用对话）/ deepseek-reasoner（推理模型）
model = "deepseek-chat"
